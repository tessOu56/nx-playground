{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "jest"
    ]
  },
  "include": [
    "src",
    "App.tsx",
    "index.ts"
  ],
  "extends": "expo/tsconfig.base"
}
