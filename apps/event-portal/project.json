{
  "name": "@nx-playground/event-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/event-portal/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "command": "pnpm exec next build --webpack",
        "cwd": "apps/event-portal"
      },
      "dependsOn": [
        {
          "target": "build",
          "projects": "dependencies"
        },
        {
          "target": "prisma-generate",
          "projects": ["@nx-playground/api-server"]
        }
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "pnpm exec next dev --webpack --port 3000",
        "cwd": "apps/event-portal"
      },
      "configurations": {
        "development": {
          "command": "pnpm exec next dev --webpack --port 3000",
          "cwd": "apps/event-portal"
        },
        "production": {
          "command": "pnpm exec next start --port 3000",
          "cwd": "apps/event-portal"
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "@nx-playground/event-portal:build"
      }
    },
    "test-weekly-digest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx --test apps/event-portal/src/libs/digest/*.test.ts apps/event-portal/src/app/api/cron/weekly-digest/route.test.ts"
      }
    },
    "test-line-bot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx --test apps/event-portal/src/libs/http/*.test.ts apps/event-portal/src/libs/line/*.test.ts apps/event-portal/src/libs/line/bot/*.test.ts apps/event-portal/src/libs/auth/*.test.ts apps/event-portal/src/app/api/line/webhook/route.test.ts"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/event-portal/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Lint skipped for events project'"
      }
    }
  },
  "tags": []
}
