// apps/api-server/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// Product path is Postgres (Neon hosted / local docker). SQLite is not allowed.

enum ExhibitionRegion {
  TAIPEI
  TOKYO
}

// ==================== 用戶模組 ====================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatar    String?
  role      String   @default("user")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  @@map("users")
}

enum IdentityRoleName {
  organizer
  admin
}

/// Better Auth identity user. Email is optional (LINE often has none).
model IdentityUser {
  id            String    @id
  name          String
  email         String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions IdentitySession[]
  accounts IdentityAccount[]
  passkeys IdentityPasskey[]
  roles    UserRole[]

  @@unique([email])
  @@map("identity_user")
}

model IdentitySession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("identity_session")
}

model IdentityAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("identity_account")
}

model IdentityVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("identity_verification")
}

model IdentityJwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("identity_jwks")
}

model IdentityPasskey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@map("identity_passkey")
}

/// Elevated roles only. Absence of a row means attendee (`user`).
model UserRole {
  id        String           @id @default(cuid())
  userId    String
  role      IdentityRoleName
  grantedBy String?
  grantedAt DateTime         @default(now())
  user      IdentityUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_role")
}

// ==================== 活動模組 ====================

model Event {
  id           String             @id @default(cuid())
  title        String
  description  String?
  location     String?
  startDate    DateTime
  endDate      DateTime
  maxAttendees Int?
  status       String             @default("draft")
  formId       String?
  data         Json?
  region       ExhibitionRegion?
  timezone     String?
  source       String?
  sourceUrl    String?
  externalId   String?
  contentHash  String?
  tags         String[]           @default([])
  priceText    String?
  lastSeenAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // search_document / search_tsv are SQL-generated (CJK bigrams + simple FTS).
  // See migration 20261020020000_exhibition_fts_embeddings. Not Prisma-managed
  // so inserts from Nest / collectors do not have to supply them.
  // EventEmbedding.embedding is pgvector (migration 20261020090000).

  form       Form?            @relation(fields: [formId], references: [id])
  embedding  EventEmbedding?

  @@unique([source, externalId])
  @@index([region])
  @@index([lastSeenAt])
  @@map("events")
}

// Document embeddings for hybrid FTS + cosine search. Written via raw SQL
// (Prisma has no native vector writes). NULL embedding = not yet generated.
model EventEmbedding {
  eventId     String                    @id @map("event_id")
  event       Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  model       String?
  dimensions  Int?
  contentHash String?                   @map("content_hash")
  embedding   Unsupported("vector")?
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  @@map("event_embeddings")
}

// ==================== 表單模組 ====================

model Form {
  id        String   @id @default(cuid())
  name      String
  schema    String // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 關聯
  events Event[]

  @@map("forms")
}

// ==================== 會話模組 ====================

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // 關聯
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Shared TTL store for portal isolates (rate limits + LINE webhook replay).
model PortalKv {
  key       String   @id
  value     String
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("portal_kv")
}
