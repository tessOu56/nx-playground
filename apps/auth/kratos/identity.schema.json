{
  "$id": "https://nx-playground.local/schemas/organizer.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Organizer",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "E-Mail",
            "minLength": 3,
            "ory.sh/kratos": {
              "credentials": {
                "password": {
                  "identifier": true
                }
              }
            }
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
