# Copy to .env (gitignored). Never commit real values.
# Local Postgres: make db-up → postgresql://event:event@127.0.0.1:5433/event_stack
# Hosted catalog: Neon event-stack URL (same DB the Nest API and LINE webhook query).

DATABASE_URL=postgresql://event:event@127.0.0.1:5433/event_stack

# Least-privilege collector role (TM-008). GitHub Actions collect/backfill
# must use this secret, not the owner DATABASE_URL. Local CLI falls back to
# DATABASE_URL when this is unset. See docs/runbooks/line-bot.md.
# COLLECTOR_DATABASE_URL=postgresql://event_collector:collector@127.0.0.1:5433/event_stack

# Optional shared rate-limit / webhook-replay store (TM-006/007).
# Unset = Neon portal_kv when DATABASE_URL is set, else in-memory fallback.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# PORTAL_SHARED_KV=memory

# LINE Messaging API channel 2012101436 (Official Account @006dcvmv).
# Do not reuse Login/LIFF secrets here. Never commit the secret or access token.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Public portal origin for Flex "open detail" buttons (optional; defaults to nx-event-portal.vercel.app)
PORTAL_PUBLIC_URL=https://nx-event-portal.vercel.app
NEXT_PUBLIC_SITE_URL=https://nx-event-portal.vercel.app

# LINE Login / LIFF channel 2011182044 (LIFF ID 2011182044-WawDftvY).
# Used for ID-token verification (aud/client_id). Separate from Messaging 2012101436.
NEXT_PUBLIC_LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LINE_REDIRECT_URI=http://localhost:3000

# In-app LINE webhook / login rate limits (60s window; shared via Upstash or
# Neon portal_kv, memory fallback). Set to 0 or false to disable.
# LINE_RATE_LIMIT=0

# Nest mutating writes from cron/collector (server-to-server only).
# Compared in constant time. CMS must not use this — organizers present a JWT.
# Never prefix this with VITE_ or NEXT_PUBLIC_ (it must not reach the browser).
ADMIN_API_TOKEN=

# Better Auth (event-portal /api/auth/*). Required in production.
# Generate: openssl rand -base64 32 — never commit the value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-cms.example

# Google OAuth web client (console redirect: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nest JWKS verification of Better Auth JWTs (15m, aud=event-stack-api).
# AUTH_JWKS_URL defaults to {AUTH_JWT_ISSUER}/api/auth/jwks when omitted.
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# AUTH_JWT_AUDIENCE=event-stack-api

# CMS Vite BFF + browser login origin (portal Better Auth, not Kratos).
VITE_AUTH_URL=http://localhost:3000
EVENT_STACK_NEST_URL=http://localhost:3001/api
# CMS_BFF_ORIGIN=http://localhost:3002,http://127.0.0.1:3002

# P4 weekly digest (Vercel cron GET /api/cron/weekly-digest).
# CRON_SECRET is required; Vercel sends Authorization: Bearer <CRON_SECRET>.
# DISCORD_WEBHOOK_URL is optional — unset means no-op publish. Never log this URL.
# Threads/X publishers are reserved in code and not implemented yet.
CRON_SECRET=
DISCORD_WEBHOOK_URL=

# Optional semantic search (pgvector hybrid ranking). Unset = FTS only; no API calls.
# Provider is openai | openai-compatible. Never commit keys.
# EMBEDDING_PROVIDER=
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_TIMEOUT_MS=12000
