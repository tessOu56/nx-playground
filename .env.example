# Copy to .env (gitignored). Never commit real values.
# Local Postgres: make db-up → postgresql://event:event@127.0.0.1:5433/event_stack
# Hosted catalog: Neon event-stack URL (same DB the Nest API and LINE webhook query).

DATABASE_URL=postgresql://event:event@127.0.0.1:5433/event_stack

# LINE Messaging API channel 2012101436 (Official Account @006dcvmv).
# Do not reuse Login/LIFF secrets here. Never commit the secret or access token.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Public portal origin for Flex "open detail" buttons (optional; defaults to nx-event-portal.vercel.app)
PORTAL_PUBLIC_URL=https://nx-event-portal.vercel.app
NEXT_PUBLIC_SITE_URL=https://nx-event-portal.vercel.app

# LINE Login / LIFF channel 2011182044 (LIFF ID 2011182044-WawDftvY).
# Used for ID-token verification (aud/client_id). Separate from Messaging 2012101436.
NEXT_PUBLIC_LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LINE_REDIRECT_URI=http://localhost:3000

# In-app LINE webhook / login rate limits (per serverless isolate, 60s window).
# Set to 0 or false to disable. Prefer Vercel WAF in front of this.
# LINE_RATE_LIMIT=0

# Nest mutating writes (events POST/PUT/DELETE) and CMS BFF → Nest.
# Server-only. Compared in constant time. If unset, every mutating request is 401.
# Never prefix this with VITE_ or NEXT_PUBLIC_ (it must not reach the browser).
ADMIN_API_TOKEN=

# Nest + CMS Vite BFF: verify organizer sessions at this Kratos public URL.
# Unset = session path fails closed. Local: http://localhost:4433
KRATOS_PUBLIC_URL=http://localhost:4433

# Emails that may receive organizer/admin after a verified Kratos session.
# Empty allowlist = no session user is promoted (fail closed).
ALLOWED_ORGANIZER_EMAILS=organizer@nx-playground.local

# Local CMS/Nest only: honor X-Organizer-Email without a Kratos session.
# Ignored whenever NODE_ENV=production.
# EVENT_STACK_CMS_DEV_AUTH=true

# P4 weekly digest (Vercel cron GET /api/cron/weekly-digest).
# CRON_SECRET is required; Vercel sends Authorization: Bearer <CRON_SECRET>.
# DISCORD_WEBHOOK_URL is optional — unset means no-op publish. Never log this URL.
# Threads/X publishers are reserved in code and not implemented yet.
CRON_SECRET=
DISCORD_WEBHOOK_URL=

# Optional semantic search (pgvector hybrid ranking). Unset = FTS only; no API calls.
# Provider is openai | openai-compatible. Never commit keys.
# EMBEDDING_PROVIDER=
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_TIMEOUT_MS=12000
